# knowledge-web environment (P12.S2). Copy to `.env.local` and fill in.
#
# Both keys are SERVER-ONLY — neither is NEXT_PUBLIC_, and both are read through
# `src/lib/env.ts`, which is `import "server-only"`. They must never be exposed to
# the browser: the whole point of the BFF (D-P12-2) is that only the Next.js server
# talks to knowledge-api, and the session key never leaves it.

# Base URL of the knowledge API the Next.js server calls server-to-server.
# Local dev: http://127.0.0.1:8766 (the dev-compose api port).
KB_API_BASE_URL=http://127.0.0.1:8766

# Secret the AES-256-GCM session key is derived from (sha256 of this value) to
# seal knowledge's bearer token into the httpOnly cookie. Use a long random string,
# e.g. `openssl rand -base64 32`. Rotating it invalidates every live session
# (all users are forced to sign in again).
SESSION_SECRET=

# hi2vi's own Send feedback control (the landing footer and org home), all seven
# SERVER-ONLY and optional. The key is the project-bound `capture` key of the
# `hi2vi` project; only the Next.js server posts with it, never the browser.
# Unset or blank: no control on either page (a self-hosted install's normal state).
# Local dev: `uv run --env-file .env python scripts/dev_feedback_key.py` mints a
# local key and writes it here, with a local test account (HI2VI_DEV_TEST_*).
HI2VI_FEEDBACK_CAPTURE_KEY=
# The six numbers: blank or not a positive integer falls back to the default shown.
# Message length cap, in characters (the limit shown on screen).
HI2VI_FEEDBACK_MAX_CHARS=2000
# Visitor (landing) messages per address, per window of seconds.
HI2VI_FEEDBACK_IP_LIMIT=5
HI2VI_FEEDBACK_IP_WINDOW_S=600
# Signed-in (org home) messages per account, per window of seconds.
HI2VI_FEEDBACK_ACCOUNT_LIMIT=10
HI2VI_FEEDBACK_ACCOUNT_WINDOW_S=600
# Landing messages per sliding 24 hours, site-wide; past it the form says try later.
HI2VI_FEEDBACK_DAILY_CEILING=200
